# Copiá como server/.env si necesitás cambiar algo. NO versionar.
# Sin .env la app arranca igual: HTTP en el puerto 4000, sirviendo frontend + API.

# Puerto del server (frontend + API)
PORT=4000

# Carpeta base donde viven las imágenes (pisa el baseDir de config.json).
# BASE_DIR=\iis\www

# Opcional: restringir CORS a ciertos orígenes (coma para varios). Vacío = sin restricción.
# CORS_ORIGIN=

# Opcional: poner false para que el server sea solo API (no sirva client/dist).
# SERVE_FRONTEND=false

# --- HTTPS opcional (elegí UNA de las dos opciones; si no, corre en HTTP) ---
# Opción A: un solo archivo .pfx/.p12 con clave + certificado
# SSL_PFX=C:\ruta\SSL\certificado.pfx
# SSL_PASSPHRASE=la-contraseña-del-pfx

# Opción B: certificado y clave por separado (.crt/.pem + .key)
# SSL_CERT=C:\ruta\SSL\certificado.crt
# SSL_KEY=C:\ruta\SSL\privada.key
# SSL_CA=C:\ruta\SSL\cadena.crt   (opcional, si el emisor lo requiere)
