# Copiá como server/.env en el servidor. NO versionar.
# En Windows conviene setear estas variables como variables de entorno del servicio
# (pm2/NSSM) en vez de un .env; el .example queda de referencia.

# Puerto del backend
PORT=4000

# Origen permitido para CORS: la URL del frontend en Vercel (coma para varios).
# Ej: https://tu-app.vercel.app
CORS_ORIGIN=

# Servir el frontend desde este backend.
# En el portal (frontend en Vercel) poner false → queda como API pura.
# En el modo "todo en una PC" dejar sin definir (sirve el frontend).
SERVE_FRONTEND=false

# Carpeta base donde viven las imágenes (pisa el baseDir de config.json).
# BASE_DIR=\\iis\www

# --- HTTPS (elegí UNA de las dos opciones) ---
# Opción A: un solo archivo .pfx/.p12 con clave + certificado
# SSL_PFX=C:\ruta\SSL\certificado.pfx
# SSL_PASSPHRASE=la-contraseña-del-pfx

# Opción B: certificado y clave por separado (.crt/.pem + .key)
# SSL_CERT=C:\ruta\SSL\certificado.crt
# SSL_KEY=C:\ruta\SSL\privada.key
# SSL_CA=C:\ruta\SSL\cadena.crt   (opcional, si el emisor lo requiere)
